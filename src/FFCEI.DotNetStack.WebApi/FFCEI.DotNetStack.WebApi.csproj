<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pin direto: Microsoft.Data.SqlClient (via EntityFramework) traz System.Security.Cryptography.Pkcs
         9.0.11, com advisories GHSA-2fmv-rv2c-59x7 (moderate) e GHSA-846f-f764-76mx (high). Os demais
         projetos resolvem 10.0.13 por conta dos pacotes Azure/OCI; aqui a resolucao cai na linha 9.x,
         entao o pin direto e necessario para o NuGetAudit passar. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FFCEI.DotNetStack.AccessControl\FFCEI.DotNetStack.AccessControl.csproj" />
  </ItemGroup>

</Project>
